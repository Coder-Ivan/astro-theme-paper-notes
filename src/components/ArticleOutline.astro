---
import OutlineItems from './OutlineItems.astro';
import { buildOutline } from '../lib/outline.ts';
import type { JournalPost } from '../lib/journal.ts';
interface Props { headings: JournalPost['headings'] }
const { headings } = Astro.props;
---
<details class="panel outline-disclosure">
  <summary>
    <svg aria-hidden="true" width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round">
      <path d="M3 5h2m3 0h13M3 12h2m3 0h10M3 19h2m3 0h13"/>
    </svg>
    <span>文章目录</span>
    <svg class="outline-chevron" aria-hidden="true" width="16" height="16" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><path d="m5 8 5 5 5-5"/></svg>
  </summary>
  <nav aria-label="文章目录"><OutlineItems items={buildOutline(headings)} /></nav>
</details>
<script>
  import './article-outline.ts';
</script>
