---
import { dateLabel, notebookAnchor, type JournalPost } from '../lib/journal.ts';
interface Props { post: JournalPost }
const { post } = Astro.props;
const path = post.notebookPath ?? [];
---
<div class="meta">
  <slot />
  {post.created && <time datetime={post.created}>{dateLabel(post.created)}</time>}
  {path[0] && <span class="notebook-path">{path.map((name, index) => <>
    {index > 0 && <span aria-hidden="true"> › </span>}
    <a href={'/categories/#' + notebookAnchor(path.slice(0, index + 1))}>{name}</a>
  </>)}</span>}
  {post.tags?.map(tag => <a href={'/tags/#' + encodeURIComponent(tag)}>#{tag}</a>)}
</div>
