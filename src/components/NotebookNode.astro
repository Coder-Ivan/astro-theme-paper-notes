---
import ArticleList from './ArticleList.astro';
import NavIcon from './NavIcon.astro';
import { notebookAnchor, type NotebookNode } from '../lib/journal.ts';

interface Props { node: NotebookNode }
const { node } = Astro.props;
---
<li>
  <details class="notebook-node" id={notebookAnchor(node.path)} open={node.path.length === 1}>
    <summary>
      <span class="notebook-chevron" aria-hidden="true"></span>
      <NavIcon name="categories" />
      <span class="notebook-title">{node.title}</span>
      <small class="notebook-count">{node.count} 篇</small>
    </summary>
    <div class="notebook-content" style={'--notebook-depth: ' + node.path.length}>
      {node.children.length > 0 && <ul class="notebook-branches">
        {node.children.map(child => <Astro.self node={child} />)}
      </ul>}
      {node.articles.length > 0 && <ArticleList articles={node.articles} />}
    </div>
  </details>
</li>
