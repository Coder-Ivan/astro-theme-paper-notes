---
import { searchIndexUrl } from '../lib/search-index.ts';
import '../styles/search.css';
import theme from '../../theme.config.mjs';
---
<dialog id="site-search-dialog" class="site-search" aria-label="站内搜索" data-index-url={searchIndexUrl} data-services={String(theme.services)}>
  <div class="search-bar">
    <svg class="search-glass" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true">
      <circle cx="10.5" cy="10.5" r="6.8"/><path d="m16 16 5 5"/>
    </svg>
    <input id="site-search-query" type="search" role="combobox" aria-label="站内搜索" placeholder="搜索文章"
      aria-autocomplete="list" aria-controls="site-search-results" aria-expanded="false" autocomplete="off"
      autocapitalize="off" spellcheck="false" enterkeyhint="go" autofocus />
    <button type="button" id="site-search-close" aria-label="关闭搜索">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" aria-hidden="true">
        <path d="m6 6 12 12M18 6 6 18"/>
      </svg>
    </button>
  </div>
  <div class="search-content" hidden>
    <p class="search-message" role="status" hidden><span></span> <button type="button" id="site-search-retry" hidden>重试</button></p>
    <div id="site-search-results" role="listbox" aria-label="搜索结果"></div>
    <button type="button" id="site-search-more" hidden>显示更多结果</button>
  </div>
  <footer class="search-footer">
    <div class="search-keys" aria-hidden="true">
      <span><kbd>↑</kbd><kbd>↓</kbd> 选择</span><span><kbd>↵</kbd> 打开</span><span><kbd>Esc</kbd> 关闭</span>
    </div>
    <span class="search-count" role="status" aria-live="polite"></span>
  </footer>
</dialog>
<script>
  import './site-search.ts';
</script>
