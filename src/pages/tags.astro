---
import Shell from '../layouts/Shell.astro';
import Sidebar from '../components/Sidebar.astro';
import ArticleList from '../components/ArticleList.astro';
import { posts, tags } from '../lib/journal.ts';
---
<Shell title="文章标签" active="tags">
  <p slot="hero-meta" class="hero-meta">共 {tags.length} 个标签</p>
  <main id="main" class="frame columns">
    <div class="panel directory">
      {tags.length > 0 ? <>
        <nav aria-label="标签索引" class="index-links">{tags.map(tag => <a href={'#' + encodeURIComponent(tag)}>{tag}</a>)}</nav>
        {tags.map(tag => <section class="directory-group" id={tag}>
          <h2>{tag}</h2><ArticleList articles={posts.filter(post => post.tags.includes(tag))}/>
        </section>)}
      </> : <p>暂无标签。<a class="text-link" href="/archives/">查看文章归档</a></p>}
    </div>
    <Sidebar/>
  </main>
</Shell>
