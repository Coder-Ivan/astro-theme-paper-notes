---
import Shell from '../layouts/Shell.astro';
import Sidebar from '../components/Sidebar.astro';
import ArticleList from '../components/ArticleList.astro';
import { notebooks, sortedNotebooks, notebookAnchor } from '../lib/journal.ts';
---
<Shell title="笔记分类" active="categories">
  <p slot="hero-meta" class="hero-meta">共 {notebooks.size} 个一级分类</p>
  <main class="frame columns" id="main">
    <div class="panel directory">
      {notebooks.size > 0 ? <>
        <nav aria-label="分类索引" class="index-links">{sortedNotebooks.map(([title, book]) => <a href={'#' + notebookAnchor([title])}>{title}<small>{book.articles.length}</small></a>)}</nav>
        {sortedNotebooks.map(([title, book]) => <section class="directory-group" id={notebookAnchor([title])}>
          <h2>{title}</h2><ArticleList articles={book.articles} />
        </section>)}
      </> : <p>暂无笔记本分类。</p>}
    </div>
    <Sidebar/>
  </main>
</Shell>
