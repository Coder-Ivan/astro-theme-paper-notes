---
import Shell from '../layouts/Shell.astro';
import Sidebar from '../components/Sidebar.astro';
import NotebookNode from '../components/NotebookNode.astro';
import { notebookTree } from '../lib/journal.ts';
import '../styles/notebook-tree.css';
import theme from '../../theme.config.mjs';

const articleCount = notebookTree.reduce((sum, root) => sum + root.count, 0);
---
<Shell title="笔记分类" active="categories">
  <p slot="hero-meta" class="hero-meta">{notebookTree.length} 个一级分类<span>·</span>{articleCount} 篇公开文章</p>
  <main class="frame columns" id="main">
    <div class="panel notebook-browser" data-diary-enabled={theme.services ? '' : undefined}>
      {notebookTree.length > 0
        ? <>
            <div class="notebook-controls" role="group" aria-label="目录展开方式" hidden>
              <button type="button" data-notebook-action="expand" aria-controls="notebook-tree">全部展开</button>
              <button type="button" data-notebook-action="collapse" aria-controls="notebook-tree">全部折叠</button>
              <button type="button" data-notebook-action="reset" aria-controls="notebook-tree">恢复默认</button>
            </div>
            <ul class="notebook-tree" id="notebook-tree" aria-label="笔记本分类">{notebookTree.map(node => <NotebookNode node={node} />)}</ul>
          </>
        : <p>暂无笔记本分类。</p>}
    </div>
    <Sidebar />
  </main>
  <script>
    let overriddenHash: string | null = null;
    const tree = document.getElementById('notebook-tree');
    const controls = document.querySelector<HTMLElement>('.notebook-controls');
    if (tree && controls) {
      const branches = tree.querySelectorAll<HTMLDetailsElement>('details.notebook-node');
      controls.addEventListener('click', event => {
        const button = event.target instanceof Element && event.target.closest<HTMLButtonElement>('button[data-notebook-action]');
        if (!button) return;
        overriddenHash = location.hash;
        const action = button.dataset.notebookAction;
        for (const branch of branches) {
          branch.open = action === 'expand' || (action === 'reset' && branch.matches('.notebook-tree > li > details'));
        }
      });
      controls.hidden = false;
    }

    function followNotebookHash() {
      overriddenHash = null;
      const match = /^#book-([\w-]+)$/.exec(location.hash);
      if (!match) return;
      const target = document.getElementById(location.hash.slice(1));
      if (target instanceof HTMLDetailsElement && target.classList.contains('notebook-node')) {
        let branch: HTMLDetailsElement | null = target;
        while (branch) {
          branch.open = true;
          branch = branch.parentElement?.closest<HTMLDetailsElement>('details.notebook-node') ?? null;
        }
        const summary = target.querySelector('summary');
        summary?.focus({ preventScroll: true });
        summary?.scrollIntoView({ block: 'start' });
        return;
      }
      // Links from before the diary moved to its own calendar use the same encoding.
      if (!document.querySelector('.notebook-browser[data-diary-enabled]')) return;
      let path: unknown;
      try {
        const bytes = atob(match[1].replace(/-/g, '+').replace(/_/g, '/'));
        path = JSON.parse(new TextDecoder().decode(Uint8Array.from(bytes, c => c.charCodeAt(0))));
      } catch { return; }
      if (!Array.isArray(path) || path[0] !== 'Journal') return;
      const month = /^(0[1-9]|1[0-2])(?:-|$)/.exec(String(path[2] ?? ''));
      const query = /^\d{4}$/.test(path[1]) && month ? '?month=' + path[1] + '-' + month[1] : '';
      location.replace('/diary/' + query);
    }
    followNotebookHash();
    window.addEventListener('hashchange', followNotebookHash);
    window.addEventListener('pageshow', event => {
      if (event.persisted && location.hash !== overriddenHash) followNotebookHash();
    });
    // A reader can close the current target and follow the same sidebar link again.
    document.addEventListener('click', event => {
      if (event.defaultPrevented || event.button !== 0 || event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;
      const link = event.target instanceof Element && event.target.closest('a');
      if (link && link.hash && link.href === location.href) followNotebookHash();
    });
  </script>
</Shell>
